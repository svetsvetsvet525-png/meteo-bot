# Токен бота от @BotFather (обязательно)
BOT_TOKEN=1234567890:AAAA...ваш_токен...

# Интервал проверки источников, секунд (по умолчанию 300 = 5 минут)
CHECK_INTERVAL=300

# Файл базы данных (относительно папки проекта или абсолютный путь)
DB_PATH=data/bot.db

# Источники данных
SITE_URL=https://www.norilsk-city.ru/meteo/
CHANNEL_URL=https://t.me/s/aktirovka_norilsk

# Основной источник — портал «Северный город» (перепечатка бюллетеня администрации)
SGNORILSK_URL=https://sgnorilsk.ru/pogoda/
# Первоисточник — официальный сайт норильск.рф (раздел «Сообщения ГОиЧС»);
# опрашивается не чаще раза в час и включается сам, когда сайт оживает
NORILSKRF_URL=https://xn--h1aecgfmj1g.xn--p1ai/weather/
# Резерв — meteonpr.ru (подключается, только если остальные молчат)
METEONPR_URL=https://meteonpr.ru/

# Прокси для российских сайтов с гео-блоком (нужен, если бот ходит из-за
# границы — например, с VPS в Финляндии). Формат:
#   http://host:port  или  http://user:pass@host:port  (socks5:// — pip install "httpx[socks]")
# Прокси должен быть в РОССИИ, иначе смысла в нём нет. Пусто = не использовать.
RU_PROXY=

# Проверка SSL-сертификата сайта администрации (0 — отключить, если сертификат просрочен)
SITE_VERIFY_SSL=1

# Часовой пояс (для определения «сегодня»)
TZ_NAME=Asia/Krasnoyarsk
